# NReader release signing — TheSkyC (2026); see NOTICE.
# Copy to keystore.properties and replace every value locally.
# Use forward slashes for Windows paths. Relative paths resolve from the project root.
# Never commit the filled file or the keystore.
storeFile=E:/private/nreader-release.jks
storePassword=replace-with-your-store-password
keyAlias=nreader
keyPassword=replace-with-your-key-password
