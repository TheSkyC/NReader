<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/gallery_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:tabIndicatorColor="@android:color/black"
        app:tabSelectedTextColor="@android:color/black"
        app:tabTextColor="@android:color/black"
        app:tabMode="fixed" />

    <com.maxwai.nclientv3.components.widgets.GalleryTabSwipeLayout
        android:id="@+id/gallery_tab_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gallery_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include layout="@layout/content_gallery" />

        <LinearLayout
            android:id="@+id/gallery_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/comments_refresher"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/comments_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/comments_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/comments_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/retry"
                android:visibility="gone" />

            <Button
                android:id="@+id/comments_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/gallery_comments_more"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/comment_composer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/comment_account_avatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comment_identity"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnSurface"
                        android:text="@string/comment_choose_account"
                        app:icon="@drawable/ic_comment_chevron_down"
                        app:iconGravity="textEnd"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorOnSurface" />
                </LinearLayout>

                <TextView
                    android:id="@+id/comment_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/comment_input_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="@color/comment_input_background"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/comment_input_stroke"
                    app:strokeWidth="1dp">

                  <FrameLayout
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:paddingStart="14dp"
                      android:paddingEnd="4dp">

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/comment_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="@string/comment_input_hint"
                        android:importantForAutofill="no"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:minHeight="44dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingEnd="54dp"
                        android:saveEnabled="false" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/comment_send"
                        style="@style/Widget.MaterialComponents.Button.Icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|end"
                        android:contentDescription="@string/comment_send"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="44dp"
                        android:padding="10dp"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_comment_send"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="22dp" />
                  </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </com.maxwai.nclientv3.components.widgets.GalleryTabSwipeLayout>
</LinearLayout>
