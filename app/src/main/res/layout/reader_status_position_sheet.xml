<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/reader_status_position_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:text="@string/reader_status_position_item"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
        <RadioGroup
            android:id="@+id/reader_status_position_item_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_position_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/reader_status_time" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_position_battery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/reader_status_battery" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_position_progress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/reader_status_progress_short" />
        </RadioGroup>
        <FrameLayout
            android:id="@+id/reader_status_position_preview_frame"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:clipChildren="false"
            android:clipToPadding="false">
            <com.theskyc.nreader.components.reader.ReaderStatusOverlayView
                android:id="@+id/reader_status_position_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        <TextView
            android:id="@+id/reader_status_overlap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/reader_status_overlap"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />
        <TextView
            android:id="@+id/reader_status_position_horizontal_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reader_status_position_horizontal"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <com.google.android.material.slider.Slider
            android:id="@+id/reader_status_position_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/reader_status_position_vertical_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reader_status_position_vertical"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <com.google.android.material.slider.Slider
            android:id="@+id/reader_status_position_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityHeading="true"
            android:text="@string/reader_status_position_corners"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_corner_top_left"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_corner_top_left" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_corner_top_right"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_corner_top_right" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_corner_bottom_left"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_corner_bottom_left" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_corner_bottom_right"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_corner_bottom_right" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_status_reset_selected"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reader_status_reset_selected" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_status_reset_all_positions"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reader_status_reset_all" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
