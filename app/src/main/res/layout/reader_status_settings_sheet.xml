<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/reader_status_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reader_status_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/reader_status_show" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/reader_status_items"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reader_status_time_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reader_status_time" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reader_status_battery_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reader_status_battery" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/reader_status_battery_format"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <RadioGroup
            android:id="@+id/reader_status_battery_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_battery_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/reader_status_battery_both" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_battery_icon_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/reader_status_battery_icon_only" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_battery_percent_only"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/reader_status_battery_percent_only" />
        </RadioGroup>
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reader_status_progress_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reader_status_progress" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/reader_status_progress_format"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <RadioGroup
            android:id="@+id/reader_status_progress_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_progress_pages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/reader_status_progress_pages" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/reader_status_progress_percent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/reader_status_progress_percent" />
        </RadioGroup>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/reader_status_visibility"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reader_status_time_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reader_status_time_idle" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reader_status_battery_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reader_status_battery_idle" />
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/reader_status_progress_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/reader_status_progress_idle" />
        <TextView
            android:id="@+id/reader_status_idle_delay_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reader_status_idle_delay"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/reader_status_idle_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_delay_2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_delay_2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_delay_3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_delay_3" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_delay_5"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_delay_5" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_delay_10"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_delay_10" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/reader_status_appearance"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reader_status_style"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/reader_status_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_style_backed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_style_backed" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reader_status_style_minimal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reader_status_style_minimal" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <TextView
            android:id="@+id/reader_status_text_size_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reader_status_text_size"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <com.google.android.material.slider.Slider
            android:id="@+id/reader_status_text_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/reader_status_opacity_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reader_status_opacity"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        <com.google.android.material.slider.Slider
            android:id="@+id/reader_status_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_status_positions"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reader_status_positions" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reader_status_reset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/reader_status_reset" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
