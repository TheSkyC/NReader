<resources>
    <style name="NReaderOverflowMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="overlapAnchor">false</item>
    </style>

    <style name="NReaderSearchBar" parent="Widget.Material3.SearchBar">
        <item name="buttonGravity">center_vertical</item>
    </style>

    <style name="NReaderTagSearchView" parent="Widget.Material3.SearchView">
        <item name="materialThemeOverlay">@style/NReaderTagSearchOverlay</item>
    </style>

    <style name="NReaderTagSearchOverlay" parent="ThemeOverlay.Material3.Search">
        <item name="materialSearchViewToolbarHeight">@dimen/tag_search_toolbar_height</item>
        <item name="materialSearchViewToolbarStyle">@style/NReaderTagSearchToolbar</item>
    </style>

    <style name="NReaderTagSearchToolbar" parent="Widget.Material3.SearchView.Toolbar">
        <item name="android:minHeight">@dimen/tag_search_toolbar_height</item>
        <item name="maxButtonHeight">@dimen/tag_search_toolbar_height</item>
    </style>

    <style name="NReaderIconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="NReaderSlider.Page" parent="Widget.Material3.Slider.Legacy">
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">8dp</item>
        <item name="haloRadius">20dp</item>
        <item name="tickVisible">false</item>
    </style>

    <style name="NReaderSlider.Value" parent="Widget.Material3.Slider.Legacy">
        <item name="trackHeight">6dp</item>
        <item name="thumbRadius">9dp</item>
        <item name="haloRadius">20dp</item>
        <item name="tickVisible">false</item>
    </style>

    <style name="NReaderSlider.Adjustment" parent="NReaderSlider.Value">
        <item name="centered">true</item>
        <item name="labelBehavior">gone</item>
    </style>

    <style name="AppTheme.Material3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/NReaderPreferenceThemeOverlay</item>
        <item name="actionOverflowMenuStyle">@style/NReaderOverflowMenu</item>
        <item name="materialSearchBarStyle">@style/NReaderSearchBar</item>
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/m3_inverse_primary</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorSecondary">@color/m3_primary</item>
        <item name="colorOnSecondary">@color/m3_on_primary</item>
        <item name="colorSecondaryContainer">@color/m3_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSurface">@color/theme_surface</item>
        <item name="colorOnSurface">@color/theme_on_surface</item>
        <item name="colorSurfaceVariant">@color/theme_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/theme_surface_variant</item>
        <item name="colorSurfaceContainer">@color/theme_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/theme_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/theme_on_surface_variant</item>
        <item name="colorOutline">@color/theme_outline</item>
        <item name="colorOutlineVariant">@color/theme_outline</item>
        <item name="colorError">@color/theme_error</item>
        <item name="colorOnError">@color/theme_on_error</item>
        <item name="colorControlActivated">@color/m3_primary</item>
        <item name="android:colorBackground">@color/theme_background</item>
        <item name="android:windowBackground">@color/theme_background</item>
        <item name="android:statusBarColor">@color/theme_background</item>
        <item name="android:navigationBarColor">@color/theme_background</item>
        <item name="android:windowLightStatusBar">@bool/m3_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/m3_light_system_bars</item>
        <item name="android:textColorPrimary">@color/theme_on_surface</item>
        <item name="android:textColorSecondary">@color/theme_on_surface_variant</item>
    </style>

    <style name="NReaderPreferenceThemeOverlay" parent="PreferenceThemeOverlay.v14.Material">
        <item name="preferenceScreenStyle">@style/NReaderPreferenceScreen</item>
        <item name="switchPreferenceCompatStyle">@style/NReaderSwitchPreference</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.Material3.TitleSmall</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Material3.BodyMedium</item>
    </style>

    <style name="NReaderPreferenceScreen" parent="Preference.PreferenceScreen.Material">
        <item name="singleLineTitle">false</item>
    </style>

    <style name="NReaderSwitchPreference" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:widgetLayout">@layout/preference_material_switch</item>
        <item name="singleLineTitle">false</item>
    </style>

    <style name="NReaderPreferenceSwitch" parent="Widget.Material3.Switch.ListItem">
        <item name="materialThemeOverlay">@style/NReaderPreferenceSwitchOverlay</item>
    </style>

    <style name="NReaderPreferenceSwitchOverlay" parent="ThemeOverlay.Material3.MaterialSwitch">
        <item name="colorOutline">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="AppTheme.Material3.Settings" parent="AppTheme.Material3">
        <item name="alertDialogTheme">@style/NReaderSettingsDialogTheme</item>
    </style>

    <style name="NReaderSettingsDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@drawable/settings_dialog_background</item>
    </style>

    <style name="AppTheme.Material3.Black" parent="AppTheme.Material3">
        <item name="colorPrimary">@color/m3_black_primary</item>
        <item name="colorOnPrimary">@color/m3_black_on_primary</item>
        <item name="colorSecondary">@color/m3_black_primary</item>
        <item name="colorOnSecondary">@color/m3_black_on_primary</item>
        <item name="colorControlActivated">@color/m3_black_primary</item>
        <item name="colorPrimaryContainer">@color/m3_black_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_black_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/m3_black_inverse_primary</item>
        <item name="colorSurfaceInverse">@color/m3_black_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_black_inverse_on_surface</item>
        <item name="colorSecondaryContainer">@color/m3_black_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_black_on_primary_container</item>
        <item name="colorSurface">@color/theme_black_surface</item>
        <item name="colorOnSurface">@color/theme_black_on_surface</item>
        <item name="colorSurfaceVariant">@color/theme_black_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/theme_black_surface_variant</item>
        <item name="colorSurfaceContainer">@color/theme_black_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/theme_black_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/theme_black_on_surface</item>
        <item name="colorOutline">@color/theme_black_outline</item>
        <item name="colorOutlineVariant">@color/theme_black_outline</item>
        <item name="android:windowBackground">@color/theme_black_background</item>
        <item name="android:colorBackground">@color/theme_black_background</item>
        <item name="android:statusBarColor">@color/theme_black_background</item>
        <item name="android:navigationBarColor">@color/theme_black_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/theme_black_on_surface</item>
        <item name="android:textColorSecondary">@color/theme_black_on_surface</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="AppTheme.Material3.Settings.Black" parent="AppTheme.Material3.Black">
        <item name="alertDialogTheme">@style/NReaderSettingsDialogTheme</item>
    </style>

</resources>
