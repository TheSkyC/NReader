        <item name="android:textColorPrimary">@color/theme_on_surface</item>
        <item name="android:textColorSecondary">@color/theme_on_surface_variant</item>
        <item name="nreaderSurfaceVariant">@color/theme_surface_variant</item>
        <item name="nreaderOutline">@color/theme_outline</item>
