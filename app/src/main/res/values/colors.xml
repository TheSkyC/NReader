    <color name="state_damaged">#B3261E</color>
    <color name="entry_background">@color/theme_image_overlay</color>
    <color name="color_overlay">@color/theme_image_overlay</color>

    <color name="tint_dark">@android:color/black</color>
    <color name="tint_light">@android:color/white</color>

    <color name="primaryColorVariant">@color/theme_primary_variant</color>
    <color name="colorAccent">@color/theme_secondary</color>
    <color name="colorPrimary">@color/theme_primary</color>
    <color name="comment_input_background">@color/theme_surface_variant</color>
