<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Semantic theme roles. Keep UI code and layouts pointed at these roles
         instead of duplicating literal colors. -->
    <color name="theme_primary">@android:color/holo_blue_bright</color>
    <color name="theme_primary_variant">@color/primary_material_light</color>
    <color name="theme_on_primary">@android:color/black</color>
    <color name="theme_secondary">@android:color/holo_blue_bright</color>
    <color name="theme_on_secondary">@android:color/black</color>
    <color name="theme_background">@android:color/white</color>
    <color name="theme_on_background">@android:color/black</color>
    <color name="theme_surface">@android:color/white</color>
    <color name="theme_on_surface">@android:color/black</color>
    <color name="theme_surface_variant">#F5F7FA</color>
    <color name="theme_on_surface_variant">#5F6368</color>
    <color name="theme_outline">#D7DCE2</color>
    <color name="theme_error">#B3261E</color>
    <color name="theme_on_error">@android:color/white</color>
    <color name="theme_image_overlay">#8F000000</color>
    <color name="theme_badge_overlay">#80000000</color>
    <color name="theme_image_scrim_strong">#D9000000</color>
    <color name="theme_image_scrim_medium">#66000000</color>
    <color name="theme_reader_overlay">#5F000000</color>
